        <p class="ai-norysia-faq__testimonial-author-{{ ai_gen_id }}">Marine F.</p>
        <a href="{{ block.settings.cta_link }}" class="ai-norysia-faq__cta-{{ ai_gen_id }}">{{ block.settings.cta_text }}</a>
      </div>

      <div class="ai-norysia-faq__testimonial-{{ ai_gen_id }}" data-content="frisottis">
        <h3 class="ai-norysia-faq__testimonial-title-{{ ai_gen_id }}">Des cheveux lisses et disciplinés</h3>
        <p class="ai-norysia-faq__testimonial-text-{{ ai_gen_id }}">Les frisottis me rendaient folle, surtout par temps humide. Mes cheveux étaient incontrôlables. NORYSIA™ a tout changé. Mes cheveux sont lisses, disciplinés et brillants. Je n'ai plus besoin de lisseur ni de produits coiffants.</p>
        <p class="ai-norysia-faq__testimonial-author-{{ ai_gen_id }}">Anaïs G.</p>
        <a href="{{ block.settings.cta_link }}" class="ai-norysia-faq__cta-{{ ai_gen_id }}">{{ block.settings.cta_text }}</a>
      </div>
    </div>
  </div>
</norysia-faq-{{ ai_gen_id }}>

<script>
  (function() {
    class NorysiaFaq{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-norysia-faq__tab-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-norysia-faq__testimonial-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const targetTab = tab.getAttribute('data-tab');
            
            this.tabs.forEach((t) => t.classList.remove('active'));
            tab.classList.add('active');
            
            this.contents.forEach((content) => {
              content.classList.remove('active');
              if (content.getAttribute('data-content') === targetTab) {
                content.classList.add('active');
              }
            });
          });
        });
      }
    }

    customElements.define('norysia-faq-{{ ai_gen_id }}', NorysiaFaq{{ ai_gen_id }});
  })();
</script>

